---
import { Image } from "astro:assets";
import logo from "../content/logos/sewmii-logo-rectangle.png";
import ButtonLink from "./ButtonLink.astro";
---

<header id="main-header" class="sticky top-0 z-50 bg-white">
    <div
        id="site-header"
        class="mx-auto flex w-full max-w-7xl items-center justify-between px-12 py-8 max-md:p-6 transition-all duration-500"
    >
        <a href="/" class="flex items-center gap-x-4">
            <Image
                id="site-logo"
                src={logo}
                alt="sewmii logo"
                class="h-16 w-auto transition-all duration-500 max-md:h-12"
            />
        </a>

        <button
            id="menu-btn"
            class="group flex flex-col gap-1.5 border-3 border-black rounded-md bg-[#A3E635] p-2 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] transition-all active:translate-x-0.75 active:translate-y-0.75 active:shadow-none md:hidden z-50"
            aria-label="Toggle Menu"
        >
            <span
                class="h-1 w-6 bg-black transition-all duration-300 origin-center group-data-open:rotate-45 group-data-open:translate-y-2.5"
            ></span>
            <span
                class="h-1 w-6 bg-black transition-all duration-300 group-data-open:opacity-0"
            ></span>
            <span
                class="h-1 w-6 bg-black transition-all duration-300 origin-center group-data-open:-rotate-45 group-data-open:-translate-y-2.5"
            ></span>
        </button>

        <nav
            id="menu-items"
            class="transition-transform duration-300 ease-in-out flex gap-8 items-center
		max-md:p-6 max-md:flex-col max-md:justify-between max-md:fixed max-md:top-24 max-md:right-0 max-md:h-[calc(100dvh-6rem)] max-md:w-full max-md:bg-white max-md:translate-x-full max-md:z-40"
        >
            <ul
                class="flex gap-x-8 w-full max-md:flex-col max-md:border-t-2 max-md:border-gray-900"
            >
                <li
                    class="max-md:min-h-19 max-md:border-b-2 max-md:border-gray-900"
                >
                    <a
                        href="/"
                        class="relative inline-block w-full text-lg font-semibold max-md:min-h-19 max-md:content-center max-md:text-[1.75rem]
					sm:after:absolute sm:after:left-0 sm:after:bottom-0 sm:after:h-px sm:after:w-full sm:after:bg-black sm:after:origin-left sm:after:scale-x-0 sm:after:transition-transform sm:after:duration-300 sm:hover:after:scale-x-100"
                    >
                        Home
                    </a>
                </li>
                <li
                    class="max-md:min-h-19 max-md:border-b-2 max-md:border-gray-900"
                >
                    <a
                        href="/products"
                        class="relative inline-block w-full text-lg font-semibold max-md:min-h-19 max-md:content-center max-md:text-[1.75rem]
					sm:after:absolute sm:after:left-0 sm:after:bottom-0 sm:after:h-px sm:after:w-full sm:after:bg-black sm:after:origin-left sm:after:scale-x-0 sm:after:transition-transform sm:after:duration-300 sm:hover:after:scale-x-100"
                    >
                        Products
                    </a>
                </li>
                <li
                    class="max-md:min-h-19 max-md:border-b-2 max-md:border-gray-900"
                >
                    <a
                        href="/services"
                        class="relative inline-block w-full text-lg font-semibold max-md:min-h-19 max-md:content-center max-md:text-[1.75rem]
					sm:after:absolute sm:after:left-0 sm:after:bottom-0 sm:after:h-px sm:after:w-full sm:after:bg-black sm:after:origin-left sm:after:scale-x-0 sm:after:transition-transform sm:after:duration-300 sm:hover:after:scale-x-100"
                    >
                        Services
                    </a>
                </li>
                <li
                    class="max-md:min-h-19 max-md:border-b-2 max-md:border-gray-900"
                >
                    <a
                        href="/calculator"
                        class="relative inline-block w-full text-lg font-semibold max-md:min-h-19 max-md:content-center max-md:text-[1.75rem]
					sm:after:absolute sm:after:left-0 sm:after:bottom-0 sm:after:h-px sm:after:w-full sm:after:bg-black sm:after:origin-left sm:after:scale-x-0 sm:after:transition-transform sm:after:duration-300 sm:hover:after:scale-x-100"
                    >
                        Calculator
                    </a>
                </li>
            </ul>
            <ButtonLink class="max-md:text-[1.75rem]" href="google.com" target="_blank" draggable={false}>
                Shop Now
            </ButtonLink>
        </nav>
    </div>
</header>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const mainHeader = document.getElementById(
            "main-header",
        ) as HTMLElement;
        const headerContainer = document.getElementById(
            "site-header",
        ) as HTMLElement;
        const logo = document.getElementById("site-logo") as HTMLElement;
        const btn = document.getElementById("menu-btn") as HTMLButtonElement;
        const menu = document.getElementById("menu-items") as HTMLUListElement;

        window.addEventListener("scroll", () => {
            if (window.scrollY > 50) {
                mainHeader.classList.remove("shadow-transparent");
                mainHeader.classList.add(
                    "shadow-sm",
                    "border-b",
                    "border-black/5",
                );

                headerContainer.classList.replace("py-8", "py-6");
                logo.classList.replace("h-16", "h-12");
            } else {
                mainHeader.classList.add("shadow-transparent");
                mainHeader.classList.remove(
                    "shadow-sm",
                    "border-b",
                    "border-black/5",
                );

                headerContainer.classList.replace("py-6", "py-8");
                logo.classList.replace("h-12", "h-16");
            }
        });

        btn.addEventListener("click", () => {
            const isOpen = btn.hasAttribute("data-open");

            if (isOpen) {
                btn.removeAttribute("data-open");
                menu.classList.add("max-md:translate-x-full");
                menu.classList.remove("max-md:translate-x-0");
                document.body.classList.remove("overflow-hidden");
            } else {
                btn.setAttribute("data-open", "");
                menu.classList.remove("max-md:translate-x-full");
                menu.classList.add("max-md:translate-x-0");
                document.body.classList.add("overflow-hidden");
            }
        });
    });
</script>
