---
import { Image } from "astro:assets";
import logo from "../content/logos/sewmii-logo-rectangle.png";
import ButtonLink from "./ButtonLink.astro";

const navLinks = [
    { name: "Home", href: "/" },
    { name: "Products", href: "/products" },
    { name: "Services", href: "/services" },
    { name: "Calculator", href: "/calculator" },
];

const navLiClass = "max-md:min-h-19 max-md:border-b-2 max-md:border-primary";
const navAnchorClass =
    "relative inline-block w-full text-lg font-semibold max-md:min-h-19 max-md:content-center max-md:text-[1.75rem] sm:after:absolute sm:after:bottom-0 sm:after:left-0 sm:after:h-px sm:after:w-full sm:after:origin-left sm:after:scale-x-0 sm:after:bg-primary sm:after:transition-transform sm:after:duration-300 sm:hover:after:scale-x-100";
---

<header id="main-header" class="sticky top-0 z-50 bg-background">
    <div
        id="site-header"
        class="mx-auto flex w-full max-w-7xl items-center justify-between px-12 py-8 transition-all duration-500 max-md:p-6"
    >
        {/* ----- Header Logo ----- */}
        <a href="/" class="flex items-center gap-x-4">
            <Image
                id="site-logo"
                src={logo}
                alt="sewmii logo"
                class="h-16 w-auto transition-all duration-500 max-md:h-12"
            />
        </a>

        {/* ----- Hamburger Menu ----- */}
        <button
            id="menu-btn"
            class="group z-50 flex flex-col gap-1.5 rounded-md border-3 border-black bg-accent p-2 shadow-brutal transition-all active:translate-x-0.75 active:translate-y-0.75 active:shadow-none md:hidden"
            aria-label="Toggle Menu"
        >
            <span
                class="h-1 w-6 origin-center bg-primary transition-all duration-300 group-data-open:translate-y-2.5 group-data-open:rotate-45"
            ></span>
            <span
                class="h-1 w-6 bg-primary transition-all duration-300 group-data-open:opacity-0"
            ></span>
            <span
                class="h-1 w-6 origin-center bg-primary transition-all duration-300 group-data-open:-translate-y-2.5 group-data-open:-rotate-45"
            ></span>
        </button>

        {/* ----- Header Navigation ----- */}
        <nav
            id="menu-items"
            class="flex items-center gap-8 transition-transform duration-300 ease-in-out max-md:fixed max-md:top-24 max-md:right-0 max-md:z-40 max-md:h-[calc(100dvh-6rem)] max-md:w-full max-md:translate-x-full max-md:flex-col max-md:justify-between max-md:bg-background max-md:p-6"
        >
            {/* ----- Navigation Links ----- */}
            <ul
                class="flex w-full gap-x-8 max-md:flex-col max-md:border-t-2 max-md:border-primary"
            >
                {
                    navLinks.map((link) => (
                        <li class={navLiClass}>
                            <a href={link.href} class={navAnchorClass}>
                                {link.name}
                            </a>
                        </li>
                    ))
                }
            </ul>

            {/* ----- Header Button Link ----- */}
            <ButtonLink
                class="max-md:text-[1.75rem]"
                href="google.com"
                target="_blank"
            >
                Shop Now
            </ButtonLink>
        </nav>
    </div>
</header>

<script>
    const initHeader = () => {
        const mainHeader = document.getElementById("main-header");
        const headerContainer = document.getElementById("site-header");
        const logo = document.getElementById("site-logo");
        const btn = document.getElementById("menu-btn");
        const menu = document.getElementById("menu-items");

        if (!mainHeader || !btn) return;

        {/* ----- Logic for reducing header size on scroll ----- */}
        window.addEventListener("scroll", () => {
            const isScrolled = window.scrollY > 50;

            mainHeader.classList.toggle("shadow-sm", isScrolled);
            mainHeader.classList.toggle("border-b", isScrolled);
            mainHeader.classList.toggle("border-black/5", isScrolled);

            headerContainer?.classList.toggle("py-6", isScrolled);
            headerContainer?.classList.toggle("py-8", !isScrolled);
            logo?.classList.toggle("h-12", isScrolled);
            logo?.classList.toggle("h-16", !isScrolled);
        });

        {/* ----- Logic for mobile hamburger menu ----- */}
        btn.addEventListener("click", () => {
            const isOpening = !btn.hasAttribute("data-open");

            btn.toggleAttribute("data-open", isOpening);

            menu?.classList.toggle("max-md:translate-x-0", isOpening);
            menu?.classList.toggle("max-md:translate-x-full", !isOpening);

            document.body.classList.toggle("overflow-hidden", isOpening);
        });
    };

    initHeader();
    document.addEventListener("astro:page-load", initHeader);
</script>
