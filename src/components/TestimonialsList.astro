---
import type { CollectionEntry } from "astro:content";
import TestimonialCard from "../components/TestimonialCard.astro";
import TestimonialModal from "../components/TestimonialModal.astro";

type Props = {
    testimonials: CollectionEntry<"testimonials">[];
};

const { testimonials } = Astro.props;
---

<div class="grid grid-cols-3 gap-8 max-lg:grid-cols-2 max-sm:grid-cols-1">
    {
        testimonials.map((testimony, index) => (
            <>
                <TestimonialCard testimony={testimony} style={`--delay: ${((index % 3) + 1) * 100}ms`} />
                <TestimonialModal testimony={testimony} />
            </>
        ))
    }
</div>

<script>
    const initTestimonials = () => {
        document.addEventListener("click", (e) => {
            const target = e.target as HTMLElement;
            if (!target) return;

            {
                /* ----- Logic for opening the modal ----- */
            }
            const trigger = target.closest("[data-testimonial-trigger]");
            if (trigger) {
                const id = trigger.getAttribute("data-testimonial-trigger");
                const modal = document.getElementById(`modal-${id}`) as HTMLDialogElement;

                modal?.showModal();
                document.body.classList.add("overflow-hidden");
                return;
            }

            {
                /* ----- Logic for closing the modal ----- */
            }
            const closeBtn = target.closest("[data-testimonial-close]");
            const isBackdrop = target.tagName === "DIALOG";

            if (closeBtn || isBackdrop) {
                const modal = (
                    closeBtn
                        ? document.getElementById(`modal-${closeBtn.getAttribute("data-testimonial-close")}`)
                        : target
                ) as HTMLDialogElement;

                modal?.close();
                document.body.classList.remove("overflow-hidden");
            }
        });

        {
            /* ----- Logic for closing the modal with ESC key ----- */
        }
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") {
                document.body.classList.remove("overflow-hidden");
            }
        });
    };

    initTestimonials();
    document.addEventListener("astro:page-load", initTestimonials);
</script>
