---
import { type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

type Props = {
    product: CollectionEntry<"products">;
};

const { product } = Astro.props;

const baseClasses =
    "flex flex-col border-3 border-black rounded-4xl bg-[#A3E635] shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] overflow-hidden";
---

<div class={baseClasses}>
    <a href={`/products/${product.data.slug}`} class="group block">
        <div
            class="relative w-full aspect-square border-b-3 border-black overflow-hidden"
        >
            <Image
                src={product.data.image}
                width={600}
                height={600}
                alt={product.data.title}
                class="absolute inset-0 w-full h-full object-cover"
            />
            {
                product.data.imageHover && (
                    <Image
                        src={product.data.imageHover}
                        width={600}
                        height={600}
                        alt={`${product.data.title} alternate view`}
                        class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity group-hover:opacity-100"
                    />
                )
            }
        </div>
        <div class="flex flex-col gap-2 p-4">
            <h2 class="text-xl font-semibold text-black">
                {product.data.title}
            </h2>
            <p class="line-clamp-2 text-sm text-black">
                {product.data.shortDescription}
            </p>
        </div>
    </a>
</div>
