---
import { type CollectionEntry } from "astro:content";
import Text from "./Text.astro";
import { Image } from "astro:assets";
import tempImage from "../content/products/images/athena-corset/athena-corset-front.png";

type Props = {
    testimony: CollectionEntry<"testimonials">;
};

const { testimony } = Astro.props;
const id = testimony.id;

const baseClasses =
    "flex flex-col border-3 border-black rounded-4xl bg-[#A3E635] shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]";
---

<div class={`${baseClasses} p-4 cursor-pointer`} data-testimonial-trigger={id}>
    <div class="mb-4 flex justify-between gap-4 items-center max-sm:flex-wrap">
        <div class="text-2xl leading-none">★★★★★</div>
        <div
            class="flex gap-1 items-center bg-white border-2 border-black rounded-full px-3 py-1
                shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]"
        >
            <span class="text-[#FF5F1F] text-xs">❖</span>
            <p class="text-[10px] font-black tracking-tight">
                VERIFIED {testimony.data.shop.toUpperCase()} PURCHASE
            </p>
        </div>
    </div>
    <Text class="sm:text-base max-sm:text-base font-medium line-clamp-5">
        “{testimony.data.review}”
    </Text>
    <span class="text-sm font-semibold">
        — {testimony.data.name}
    </span>
</div>

<dialog
    id={`modal-${id}`}
    class="fixed m-auto bg-transparent overflow-visible backdrop:bg-black/50 backdrop:backdrop-blur-sm"
>
    <button
        class="absolute top-0 right-0 -mt-2 -mr-2 z-30 flex items-center justify-center w-8 h-8 border-3 border-black rounded-full bg-white font-black transition-colors hover:bg-black hover:text-white focus:outline-none cursor-pointer"
        data-testimonial-close={id}
    >
        ✕
    </button>
    <div
        class={`${baseClasses} p-6 gap-6 max-sm:gap-4 w-[90vw] max-w-4xl relative m-auto flex-row max-sm:flex-col`}
    >
        <div
            class="w-full flex-1 bg-white border-3 border-black rounded-2xl aspect-square overflow-hidden"
        >
            <Image
                src={tempImage}
                alt={`Review for ${testimony.data.shop}`}
                class="w-full h-full object-cover"
                draggable="false"
            />
        </div>

        <div class="flex flex-col flex-1 max-lg:flex-2">
            <div
                class="mb-4 flex justify-between gap-4 items-center max-sm:flex-wrap"
            >
                <div class="text-2xl leading-none">★★★★★</div>
                <div
                    class="flex gap-1 items-center bg-white border-2 border-black rounded-full px-3 py-1
                shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]"
                >
                    <span class="text-[#FF5F1F] text-xs">❖</span>
                    <p class="text-[10px] font-black tracking-tight">
                        VERIFIED {testimony.data.shop.toUpperCase()} PURCHASE
                    </p>
                </div>
            </div>
            <Text
                class="sm:text-base max-md:max-h-56 max-sm:overflow-y-auto max-sm:text-base"
            >
                “{testimony.data.review}”
            </Text>
            <div
                class="flex items-center justify-between mt-auto pt-4 border-t border-t-gray-500"
            >
                <span class="text-sm font-semibold">
                    — {testimony.data.name}
                </span>
                <a
                    class="text-sm text-white font-semibold bg-black px-4 py-2 rounded-lg
                    shadow-[3px_3px_0px_0px_rgba(255,255,255,1)] transition-all hover:translate-x-0.75 hover:translate-y-0.75 hover:shadow-none"
                    href="/"
                    draggable="false"
                >
                    View Product
                </a>
            </div>
        </div>
    </div>
</dialog>
