---
import { type CollectionEntry } from "astro:content";
import Text from "../components/Text.astro";
import { Image } from "astro:assets";

type Props = {
    testimony: CollectionEntry<"testimonials">;
    index?: number;
    style?: string;
};

const { testimony, index = 0, style } = Astro.props;
const id = testimony.id;

const bgMap = [
    "bg-white",
    "bg-accent-pink/50",
    "bg-accent-blue/50",
    "bg-accent-pink/50",
    "bg-accent-blue/50",
    "bg-white",
];
const accentBg = bgMap[index] ?? "bg-white";
const baseClasses =
    "flex flex-col rounded-4xl border-3 border-primary p-4 shadow-brutal animate-on-scroll";
---

<div class:list={[accentBg, baseClasses]} {style}>
    <div class="aspect-square overflow-hidden rounded-2xl border-3 border-primary mb-4">
        <Image
            src={testimony.data.image}
            alt={`Review from ${testimony.data.name} for ${testimony.data.shop}`}
            class="h-full object-cover"
            draggable="false"
        />
    </div>

    {/* ----- Testimony Card Header ----- */}
    <div class="mb-4 flex items-center justify-between gap-4 max-md:flex-wrap">
        <div class="text-2xl leading-none">★★★★★</div>
        <div class="flex items-center gap-1 rounded-full border-2 border-primary bg-white px-3 py-1 shadow-brutal">
            <span class="text-xs text-orange-500">❖</span>
            <p class="text-[10px] font-black tracking-tight">
                VERIFIED {testimony.data.shop.toUpperCase()} PURCHASE
            </p>
        </div>
    </div>

    {/* ----- Testimony Card Review ----- */}
    <Text class="line-clamp-5 font-medium sm:text-base">
        “{testimony.data.review}”
    </Text>

    {/* ----- Testimony Card Footer ----- */}
    <div class="mt-auto flex items-center justify-between">
        <span class="text-sm font-semibold">— {testimony.data.name}</span>
        <button
            type="button"
            data-testimonial-trigger={id}
            aria-label={`Read full review from ${testimony.data.name}`}
            class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border-3 border-primary bg-white pr-0.5 pb-0.5 text-3xl leading-none shadow-brutal transition-all hover:translate-x-0.75 hover:translate-y-0.75 hover:shadow-none"
        >
            ›
        </button>
    </div>
</div>