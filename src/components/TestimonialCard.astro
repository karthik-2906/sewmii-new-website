---
import { type CollectionEntry } from "astro:content";
import Text from "../components/Text.astro";

type Props = {
    testimony: CollectionEntry<"testimonials">;
    index?: number;
    style?: string;
};

const { testimony, index = 0, style } = Astro.props;
const id = testimony.id;

const bgMap = ["bg-white", "bg-accent-pink/50", "bg-accent-blue/50", "bg-accent-blue/50", "bg-white", "bg-accent-pink/50"];
const accentBg = bgMap[index] ?? "bg-white";
const baseClasses =
    "flex cursor-pointer flex-col rounded-4xl border-3 border-primary p-4 shadow-brutal animate-on-scroll";
---

<div class:list={[accentBg, baseClasses]} data-testimonial-trigger={id} {style}>
    {/* ----- Testimony Card Header ----- */}
    <div class="mb-4 flex items-center justify-between gap-4 max-md:flex-wrap">
        <div class="text-2xl leading-none">★★★★★</div>
        <div class="flex items-center gap-1 rounded-full border-2 border-primary bg-white px-3 py-1 shadow-brutal">
            <span class="text-xs text-orange-500">❖</span>
            <p class="text-[10px] font-black tracking-tight">
                VERIFIED {testimony.data.shop.toUpperCase()} PURCHASE
            </p>
        </div>
    </div>

    {/* ----- Testimony Card Review ----- */}
    <Text class="line-clamp-5 font-medium sm:text-base">
        “{testimony.data.review}”
    </Text>

    {/* ----- Testimony Card Footer ----- */}
    <span class="mt-auto text-sm font-semibold">— {testimony.data.name}</span>
</div>
