---
interface Props {
    as?: "h1" | "h2" | "h3" | "h4";
    class?: string;
}

const { as = "h2", class:className = "" } = Astro.props as Props;

const Tag = as;
const baseClasses =
    "text-5xl font-bold tracking-tight mb-6 max-md:text-4xl max-md:mb-4";
---

<Tag class={`${baseClasses} ${className}`}>
    <slot />
</Tag>
