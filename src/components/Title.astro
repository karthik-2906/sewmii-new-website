---
import { twMerge } from "tailwind-merge";

interface Props {
    as?: "h1" | "h2" | "h3" | "h4";
    class?: string;
    style?: string;
}

const { as = "h2", class: className, style } = Astro.props as Props;

const Tag = as;
const baseClasses = "text-4xl max-md:text-3xl font-bold tracking-tight mb-6 max-sm:mb-4";
---

<Tag class={twMerge(baseClasses, className)} {style}>
    <slot />
</Tag>
