---
type Props = {
    class?: string;
    href?: string;
    target?: string;
};

const {
    class: className = "",
    href = "/",
    target = "_self",
} = Astro.props;

const baseClasses =
    "flex w-max flex-col gap-1.5 rounded-4xl border-3 border-black bg-accent px-4 py-2 text-lg font-semibold text-nowrap shadow-brutal transition-all select-none hover:translate-x-0.75 hover:translate-y-0.75 hover:shadow-none";
---

<a
    class={`${baseClasses} ${className}`}
    href={href}
    target={target}
    draggable=false
>
    <slot />
</a>
