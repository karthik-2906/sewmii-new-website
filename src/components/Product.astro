---
import { type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

type Props = {
    product: CollectionEntry<"products">;
};

const { product } = Astro.props;
---

<article>
    <a href={`/products/${product.data.slug}`}>
        <Image
            src={product.data.image}
            width={600}
            height={600}
            alt={product.data.title}
            class="mb-4 rounded-2xl object-cover shadow-xl"
        />
    </a>
    <a
        href={`/products/${product.data.slug}`}
        class="inline-block text-2xl font-semibold text-zinc-900"
    >
        <h2>{product.data.title}</h2>
    </a>
    <p class="line-clamp-2 text-2xl text-zinc-500">
        {product.body}
    </p>
</article>
