---
import { twMerge } from "tailwind-merge";
import Title from "./Title.astro";
import Text from "./Text.astro";
import List from "./List.astro";
import ButtonLink from "./ButtonLink.astro";

type Props = {
    title: string;
    description: string;
    features: string[];
    buttonText: string;
    buttonHref: string;
    target: string;
    class?: string;
    style: string;
};

const { title, description, features, buttonText, buttonHref, target, class: className, style } = Astro.props;
---

<div
    class={twMerge(
        "animate-on-scroll flex flex-col rounded-4xl border-3 border-primary p-8 shadow-brutal max-md:p-6",
        className,
    )}
    {style}
>
    <Title as="h3" class="text-3xl max-md:text-2xl">{title}</Title>
    <Text class="mb-8">{description}</Text>
    <List items={features} class="mb-8" />
    <ButtonLink href={buttonHref} {target} class="mt-auto bg-white">{buttonText}</ButtonLink>
</div>
