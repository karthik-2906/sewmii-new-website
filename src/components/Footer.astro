---
import { twMerge } from "tailwind-merge";
import { Image } from "astro:assets";
import logo from "../content/logos/sewmii-logo-text-light.png";
import Title from "./Title.astro";
import Text from "./Text.astro";

const navLinks = [
    { name: "Home", href: "/" },
    { name: "Products", href: "/products" },
    { name: "Services", href: "/services" },
    // { name: "Calculator", href: "/calculator" },
];

const socialLinks = [
    { name: "Instagram", href: "https://www.instagram.com/sewmii.studio/" },
    { name: "TikTok", href: "https://www.tiktok.com/@sewmii.studio" },
    { name: "YouTube", href: "https://www.youtube.com/@sewmii" },
    { name: "Etsy Shop", href: "https://sewmii.etsy.com" },
    { name: "Shopee", href: "https://shopee.ph/sewmii" },
];

const currentYear = new Date().getFullYear();

const footerH4Class = "mb-4 text-[11px] font-black tracking-widest text-accent-pink max-md:text-[11px]";

const footerAnchorClass =
    "relative inline-block w-fit after:absolute after:bottom-0 after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-white after:transition-transform after:duration-300 hover:after:scale-x-100";
---

<footer class="bg-black text-white animate-on-scroll">
    <div class="mx-auto w-full max-w-7xl px-12 py-18 max-md:px-6 max-md:py-12">
        <div
            class="mb-20 grid grid-cols-[2fr_1fr_1fr] gap-16 max-lg:grid-cols-3 max-md:mb-12 max-md:grid-cols-1 max-md:gap-12"
        >
            {/* ----- Footer Left Column ----- */}
            <div class="flex flex-col gap-6">
                <a href="/" class="">
                    <Image src={logo} alt="sewmii logo" class="h-12 w-auto" />
                </a>
                <div>
                    <Text class="mb-6 max-w-sm text-base max-sm:mb-4"
                        >Beginner-friendly digital and printed sewing patterns. Designed in the Philippines.</Text
                    >

                    <Title as="h4" class={footerH4Class}>CONTACT US</Title>
                    <a
                        href="mailto:info.sewmii@gmail.com"
                        class={twMerge(footerAnchorClass, "text-xl font-bold")}
                        target="_blank"
                        draggable="false"
                    >
                        info.sewmii@gmail.com
                    </a>
                </div>
            </div>

            {/* ----- Footer Middle Column ----- */}
            <div>
                <Title as="h4" class={footerH4Class}> EXPLORE </Title>
                <ul class="flex flex-col gap-4">
                    {
                        navLinks.map((link) => (
                            <li>
                                <a href={link.href} class={twMerge(footerAnchorClass, "text-xl font-bold")}>
                                    {link.name}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>

            {/* ----- Footer Right Column ----- */}
            <div>
                <Title as="h4" class={footerH4Class}> FOLLOW THE STUDIO </Title>
                <ul class="flex flex-col gap-4">
                    {
                        socialLinks.map((social) => (
                            <li>
                                <a
                                    href={social.href}
                                    class={twMerge(footerAnchorClass, "text-xl font-bold")}
                                    target="_blank"
                                >
                                    {social.name}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>

        {/* ----- Bottom Footer ----- */}
        <div
            class="flex flex-col items-center justify-between gap-6 border-t border-gray-400 pt-8 text-gray-400 md:flex-row"
        >
            <Text class="text-[10px] font-black tracking-widest max-md:text-[10px]">
                © {currentYear} SEWMII PATTERN STUDIO.
            </Text>
            <div class="text-[10px] font-black tracking-widest uppercase">
                <a href="/terms" class={footerAnchorClass}>Privacy Policy</a>
                <span class="px-2">|</span>
                <a href="/terms" class={footerAnchorClass}>Terms of Service</a>
            </div>
        </div>
    </div>
</footer>
