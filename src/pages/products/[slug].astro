---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import Title from "../../components/Title.astro";
import Text from "../../components/Text.astro";
import ButtonLink from "../../components/ButtonLink.astro";
import Carousel from "../../components/Carousel.astro";
import ProductsList from "../../components/ProductsList.astro";

const products = await getCollection("products");

export const getStaticPaths = async () => {
    const products = await getCollection("products");
    return products.map((product) => ({
        params: { slug: product.data.slug },
        props: { product },
    }));
};

type Props = {
    product: CollectionEntry<"products">;
};

const { product } = Astro.props;
const otherProducts = products.filter((p) => p.data.slug !== product.data.slug);
---

<Layout title={product.data.title}>
    <main>
        {/* ----- Product Listing ----- */}
        <Section>
            <div class="flex gap-16 max-lg:flex-col max-lg:gap-8">
                {/* ----- Product Carousel ----- */}
                <div class="animate-on-scroll flex-3">
                    <Carousel images={product.data.imageCarousel} />
                </div>

                {/* ----- Product Info ----- */}
                <div class="animate-on-scroll flex flex-2 flex-col" style="--delay: 150ms;">
                    <Title as="h3" class="text-base text-accent-pink uppercase max-md:text-base">{product.data.label}</Title>
                    <Title as="h1">{product.data.title}</Title>
                    <Text class="mb-8 max-md:mb-6">{product.data.description}</Text>

                    {/* ----- Available Sizes ----- */}
                    <div class="mb-8 max-md:mb-6">
                        <Text class="mb-3 text-xs font-black tracking-widest text-gray-500 max-md:text-xs"
                            >AVAILABLE SIZES</Text
                        >
                        <div class="flex flex-wrap gap-2">
                            {
                                ["2XS", "XS", "S", "M", "L", "XL", "2XL"].map((size) => (
                                    <span class="rounded-full border-3 border-primary px-4 py-1 text-sm font-bold">
                                        {size}
                                    </span>
                                ))
                            }
                        </div>
                    </div>

                    {/* ----- Available Print Sizes ----- */}
                    <div class="mb-8 max-md:mb-6">
                        <Text class="mb-3 text-xs font-black tracking-widest text-gray-500 max-md:text-xs">
                            AVAILABLE PRINT SIZES
                        </Text>
                        <div class="flex flex-wrap gap-2">
                            <span class="rounded-full border-3 border-primary px-4 py-1 text-sm font-bold">A4</span>
                            <span class="rounded-full border-3 border-primary px-4 py-1 text-sm font-bold">Letter</span>
                            <span class="rounded-full border-3 border-primary px-4 py-1 text-sm font-bold">A0</span>
                        </div>
                        <Text class="mt-2 text-sm font-bold text-gray-500">*A0 Available on request</Text>
                    </div>

                    {/* ----- Button Links ----- */}
                    <div class="flex gap-4 max-md:flex-col">
                        <ButtonLink
                            href={product.data.etsyLink}
                            variant="ghost"
                            target="_blank"
                            class="border-black bg-white text-black"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="red"
                                style="flex-shrink: 0;"
                            >
                                <path
                                    d="M23 7s-.3-1.9-1.2-2.7c-1.1-1.2-2.4-1.2-3-1.3C16.1 3 12 3 12 3s-4.1 0-6.8.2c-.6.1-1.9.1-3 1.3C1.3 5.1 1 7 1 7S.7 9.1.7 11.1v1.8c0 2 .3 4 .3 4s.3 1.9 1.2 2.7c1.1 1.2 2.6 1.1 3.3 1.2C7.3 21 12 21 12 21s4.1 0 6.8-.3c.6-.1 1.9-.1 3-1.3.9-.8 1.2-2.7 1.2-2.7s.3-2 .3-4v-1.8C23.3 9.1 23 7 23 7zM9.7 15.5V8.4l8.1 3.6-8.1 3.5z"
                                ></path>
                            </svg>
                            Watch Tutorial
                        </ButtonLink>
                        <ButtonLink
                            href={product.data.etsyLink}
                            variant="ghost"
                            target="_blank"
                            class="border-black bg-black"
                        >
                            Buy on Etsy
                        </ButtonLink>
                    </div>
                </div>
            </div>
        </Section>

        {/* ----- Other Products ----- */}
        <Section class="bg-background-alternate animate-on-scroll">
            <Title as="h2">Other Products</Title>
            <Text class="mb-12 max-md:mb-8">Three ways to get your hands on a sewmii pattern</Text>
            <ProductsList products={otherProducts} />
        </Section>
    </main>
</Layout>
