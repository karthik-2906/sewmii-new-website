---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import promoImg from "../content/products/images/ophelia-corset/ophelia-corset-tech-drawing.jpg";
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Title from "../components/Title.astro";
import Text from "../components/Text.astro";
import ButtonLink from "../components/ButtonLink.astro";
import List from "../components/List.astro";
import ProductsList from "../components/ProductsList.astro";
import TestimonialsList from "../components/TestimonialsList.astro";

const products = await getCollection("products");
const testimonials = await getCollection("testimonials");
---

<Layout title="Homepage">
    <main>
        {/* ----- Intro ----- */}
        <Section bg="bg-amber-50">
            <Title as="h1">Sewmii Pattern Studio</Title>
            <Text>
                Sewmii Pattern Studio – Love sewing but not patternmaking? Our
                beginner-friendly digital and printed sewing patterns make it
                easy to create beautiful clothing at home or for your garment
                business. Designed by a pattern maker from the Philippines, each
                pattern is ready to sew, easy to follow, and perfect for DIY
                fashion.
            </Text>
        </Section>

        {/* ----- New Launch ----- */}
        <Section>
            <div class="flex gap-16 max-lg:flex-col-reverse max-lg:gap-8">
                <div class="flex flex-col justify-center">
                    <Title
                        as="h3"
                        class="text-base text-blue-800 max-md:text-base"
                    >
                        NEW LAUNCH
                    </Title>
                    <Title as="h2">Ophelia Corset</Title>
                    <Text>
                        Ophelia Corset is a timeless sewing pattern designed to
                        celebrate classic femininity with a beautifully sculpted
                        silhouette. Featuring a thoughtfully contoured waist,
                        Ophelia creates an elegant cinch that enhances natural
                        curves and delivers a refined hourglass shape. The
                        design balances structure and softness, making it
                        flattering, versatile, and effortlessly graceful.
                        Perfect for sewists who love enduring style with a touch
                        of drama, Ophelia Corset is a pattern that feels both
                        iconic and timeless.
                    </Text>
                    <ButtonLink class="mt-4">View Item</ButtonLink>
                </div>
                <Image
                    src={promoImg}
                    alt="Temp alt"
                    height={500}
                    width={500}
                    class="aspect-square self-center"
                />
            </div>
        </Section>

        {/* ----- Services ----- */}
        <Section>
            <div class="flex gap-16 max-lg:flex-col max-lg:gap-8">
                <Image
                    src={promoImg}
                    alt="Temp alt"
                    height={500}
                    width={500}
                    class="aspect-square self-center"
                />
                <div class="flex flex-col justify-center">
                    <Title as="h2">Our Services</Title>
                    <Text class="mb-6">
                        We offer a wide array of services to help bring your
                        creative ideas to life.
                    </Text>
                    <List
                        items={[
                            "Digital sewing patterns",
                            "Physical sewing patterns ❖",
                            "Custom exclusive patterns",
                        ]}
                    />
                    <Text
                        class="text-xs leading-tight font-bold tracking-widest text-gray-500 uppercase max-md:text-xs"
                    >
                        ❖ Physical patterns: PH / SG / MY via Shopee only.
                    </Text>
                    <ButtonLink class="mt-4">View Services</ButtonLink>
                </div>
            </div>
        </Section>

        {/* ----- Featured Products ----- */}
        <Section>
            <div class="mb-12 flex items-center justify-between max-sm:mb-8 max-sm:flex-col max-sm:items-start max-sm:gap-2">
                <Title as="h2" class="mb-0"> Featured Products </Title>
                <ButtonLink class="mb-0">View All</ButtonLink>
            </div>
            <ProductsList products={products} />
        </Section>

        {/* ----- Testimonials ----- */}
        <Section>
            <Title as="h2">Testimonials</Title>
            <Text class="mb-12 max-md:mb-8">
                Loved by customers who’ve tried our sewing patterns and designs.
            </Text>
            <TestimonialsList testimonials={testimonials} />
        </Section>
    </main>
</Layout>
