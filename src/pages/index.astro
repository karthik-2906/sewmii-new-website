---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import opheliaBanner from "../content/products/images/ophelia-corset/ophelia-corset-banner.png";
import opheliaPattern from "../content/products/images/ophelia-corset/ophelia-corset-pattern.jpg";
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Title from "../components/Title.astro";
import Text from "../components/Text.astro";
import ButtonLink from "../components/ButtonLink.astro";
import List from "../components/List.astro";
import ProductsList from "../components/ProductsList.astro";
import TestimonialsList from "../components/TestimonialsList.astro";

const products = await getCollection("products");
const testimonials = await getCollection("testimonials");

const featuredProducts = products.filter((p) => p.data.featured === true);
---

<Layout title="Homepage">
    <main>
        {/* ----- Banner ----- */}
        <section class="relative">
            <Image
                src={opheliaBanner}
                alt="Ophelia Corset New Launch Hero"
                height={1080}
                width={1920}
                class="w-full max-md:h-100 h-[calc(100vh-128px)] object-cover"
                loading="eager"
                fetchpriority="high"
            />

            {/* ----- Overlay ----- */}
            <div class="absolute inset-0 bg-black/30" aria-hidden="true"></div>

            {/* ----- Banner Text Content ----- */}
            <div class="absolute inset-0 z-10 flex items-center">
                <div class="mx-auto w-full max-w-7xl px-12 py-24 max-md:p-6 max-md:max-w-72 max-md:m-0">
                    <div class="flex max-w-xl flex-col justify-center">
                        <Title
                            as="h3"
                            class="text-base text-yellow-200 drop-shadow-[2px_2px_0px_rgba(0,0,0,1)] max-md:text-base"
                        >
                            NEW LAUNCH
                        </Title>
                        <Title as="h2" class="text-white drop-shadow-[2px_2px_0px_rgba(0,0,0,1)] max-md:text-3xl"
                            >Ophelia Corset</Title
                        >
                        <Text class="text-white drop-shadow-[2px_2px_0px_rgba(0,0,0,1)]">
                            A timeless sewing pattern featuring a beautifully sculpted silhouette and elegant cinched
                            waist. Designed for enduring style with a touch of drama.
                        </Text>
                        <ButtonLink href="/products/ophelia-corset" class="mt-4">View Item</ButtonLink>
                    </div>
                </div>
            </div>
        </section>

        {/* ----- Intro ----- */}
        <Section>
            <div class="flex gap-16 max-lg:flex-col max-lg:gap-8">
                <div class="flex flex-col justify-center animate-on-scroll">
                    <Title as="h1" class="max-w-100 leading-12 max-md:leading-10"
                        >Beginner-Friendly Digital Sewing Patterns</Title
                    >
                    <Text class="mb-0 max-md:mb-0">
                        Love sewing but not patternmaking? Sewmii offers beginner-friendly digital and printed sewing
                        patterns designed to make garment-making at home simple and enjoyable. Designed by a pattern
                        maker from the Philippines, each pattern is ready to sew, easy to follow, and perfect for DIY
                        fashion.
                    </Text>
                </div>
                <Image
                    src={opheliaPattern}
                    alt="Sewmii sewing pattern pieces laid out on a cutting mat"
                    height={500}
                    width={500}
                    class="aspect-video object-cover rounded-4xl border-3 border-black shadow-brutal animate-on-scroll"
                    style="--delay: 100ms;"
                />
            </div>
        </Section>

        {/* ----- Featured Products ----- */}
        <Section class="bg-background-alternate animate-on-scroll">
            <div
                class="mb-12 flex items-center justify-between max-sm:mb-8 max-sm:flex-col max-sm:items-start max-sm:gap-2"
            >
                <Title as="h2" class="mb-0"> Featured Products </Title>
                <ButtonLink href="/products" class="mb-0">View All</ButtonLink>
            </div>
            <ProductsList products={featuredProducts} />
        </Section>

        {/* ----- Services ----- */}
        <Section>
            <div class="flex gap-16 max-lg:flex-col max-lg:gap-8">
                <Image
                    src={opheliaPattern}
                    alt="Sewmii sewing pattern pieces laid out on a cutting mat"
                    height={500}
                    width={500}
                    class="aspect-square self-center rounded-4xl border-3 border-black shadow-brutal animate-on-scroll"
                />
                <div class="flex flex-col justify-center animate-on-scroll" style="--delay: 100ms;">
                    <Title as="h2">Our Services</Title>
                    <Text class="mb-6">
                        From digital downloads to custom designs, we have a pattern for every project.
                    </Text>
                    <List
                        items={["Digital sewing patterns", "Physical sewing patterns ❖", "Custom exclusive patterns"]}
                    />
                    <Text
                        class="text-xs leading-tight font-bold tracking-widest text-gray-500 uppercase max-md:text-xs"
                    >
                        ❖ Physical patterns: Philippines, Singapore & Malaysia — via Shopee only.
                    </Text>
                    <ButtonLink href="/services" class="mt-4">View Services</ButtonLink>
                </div>
            </div>
        </Section>

        {/* ----- Stats ----- */}
        <Section class="bg-background-alternate">
            <div class="grid grid-cols-3 divide-x-4 text-center max-md:grid-cols-1 max-md:divide-x-0 max-md:divide-y-4">
                <div class="px-12 py-8 md:py-0 animate-on-scroll" style="--delay: 100ms;">
                    <Title as="h3" class="max-md:text-4xl">10</Title>
                    <Title as="h4" class="text-2xl font-medium max-md:text-xl">Years Experience</Title>
                    <Text class="mb-0">Trusted expertise in pattern making</Text>
                </div>
                <div class="px-12 py-8 md:py-0 animate-on-scroll" style="--delay: 200ms;">
                    <Title as="h3" class="max-md:text-4xl">1,000+</Title>
                    <Title as="h4" class="text-2xl font-medium max-md:text-xl">Orders Fulfilled</Title>
                    <Text class="mb-0">Happy sewers worldwide</Text>
                </div>
                <div class="px-12 py-8 md:py-0 animate-on-scroll" style="--delay: 200ms;">
                    <Text class="text-xl content-center h-12 max-md:text-xl max-mg:h-unset">⭐⭐⭐⭐⭐</Text>
                    <Title as="h4" class="text-2xl font-medium max-md:text-xl">Rated 4.9 / 5</Title>
                    <Text class="mb-0">Across Etsy & Shopee</Text>
                </div>
            </div>
        </Section>

        {/* ----- Testimonials ----- */}
        <Section class="animate-on-scroll">
            <Title as="h2">Testimonials</Title>
            <Text class="mb-12 max-md:mb-8"> Loved by customers who’ve tried our sewing patterns and designs. </Text>
            <TestimonialsList testimonials={testimonials} />
        </Section>
    </main>
</Layout>
