---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Title from "../components/Title.astro";
import Text from "../components/Text.astro";
import ProductsList from "../components/ProductsList.astro";
import ButtonLink from "../components/ButtonLink.astro";

const products = await getCollection("products");
---

<Layout title="Product Page">
    <main>
        {/* ----- All Products ----- */}
        <Section class="bg-background-alternate animate-on-scroll">
            <Title as="h2" class="mb-12 max-sm:mb-8"> All Products </Title>
            <ProductsList products={products} />
        </Section>

        {/* ----- Custom Order ----- */}
        <Section class="animate-on-scroll">
            <div
                class="flex items-center justify-between gap-8 rounded-4xl border-3 bg-black p-16 max-md:flex-col max-md:items-start max-md:p-8"
            >
                <div class="flex flex-col justify-center text-white">
                    <Title as="h3" class="text-base text-accent-pink max-md:text-base">CUSTOM ORDERS</Title>
                    <Title as="h2" class="max-md:text-3xl">Can't find what you're looking for?</Title>
                    <Text class="mb-0">Request a custom exclusive pattern tailored to your design.</Text>
                </div>
                <ButtonLink
                    href="/services#pricing"
                    class="w-fit text-black bg-accent-pink border-accent-pink max-md:w-full"
                    variant="ghost"
                >
                    View Services
                </ButtonLink>
            </div>
        </Section>
    </main>
</Layout>
